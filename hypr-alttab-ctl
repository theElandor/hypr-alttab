#!/usr/bin/python3 -S
"""Send a command (next | prev | commit | cancel | quit) to the hypr-alttab daemon.

Starts the daemon if it isn't running. Kept dependency-free so it starts fast.
"""

import os
import shutil
import socket
import subprocess
import sys
import time

APP_NAME = "hypr-alttab"


def socket_path():
    runtime = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "default")
    return os.path.join(runtime, f"{APP_NAME}-{sig}.sock")


def send(path, msg):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.connect(path)
        s.sendall(msg.encode())


def daemon_cmd():
    here = os.path.dirname(os.path.realpath(__file__))
    local = os.path.join(here, APP_NAME)
    if os.access(local, os.X_OK):
        return [local]
    found = shutil.which(APP_NAME)
    return [found] if found else None


def main():
    cmds = sys.argv[1:] or ["next"]
    msg = " ".join(cmds) + "\n"
    path = socket_path()
    try:
        send(path, msg)
        return 0
    except (FileNotFoundError, ConnectionRefusedError):
        pass
    if cmds[0] not in ("next", "prev"):
        return 0
    cmd = daemon_cmd()
    if not cmd:
        print(f"{APP_NAME}-ctl: cannot find the {APP_NAME} daemon", file=sys.stderr)
        return 1
    subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)
    deadline = time.monotonic() + 3
    while time.monotonic() < deadline:
        time.sleep(0.05)
        try:
            send(path, msg)
            return 0
        except (FileNotFoundError, ConnectionRefusedError):
            continue
    print(f"{APP_NAME}-ctl: daemon did not start", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
