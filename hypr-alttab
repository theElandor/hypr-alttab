def log(*args):
    print(f"[{APP_NAME}]", *args, file=sys.stderr, flush=True)


def parse_color(s):
    s = s.strip().lstrip("#")
    if len(s) == 6:
        s += "ff"
    r, g, b, a = (int(s[i:i + 2], 16) / 255 for i in range(0, 8, 2))
    return r, g, b, a


def socket_path():
    runtime = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "default")
    return os.path.join(runtime, f"{APP_NAME}-{sig}.sock")


# --------------------------------------------------------------------------
# Hyprland IPC
# --------------------------------------------------------------------------

class Hyprland:
    def __init__(self):
        runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
        sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
        if not sig:
            raise SystemExit(f"{APP_NAME}: HYPRLAND_INSTANCE_SIGNATURE is not set; is Hyprland running?")
        self.path = os.path.join(runtime, "hypr", sig, ".socket.sock")

    def request(self, cmd):
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.connect(self.path)
            s.sendall(cmd.encode())
            chunks = []
            while True:
                data = s.recv(65536)
                if not data:
                    break
                chunks.append(data)
        return b"".join(chunks).decode(errors="replace")

    def json(self, what):
        return json.loads(self.request(f"j/{what}"))

    def dispatch(self, args):
        return self.request(f"dispatch {args}")


