# Control socket
# --------------------------------------------------------------------------

def serve(switcher, path):
    if os.path.exists(path):
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                s.connect(path)
            raise SystemExit(f"{APP_NAME}: already running ({path})")
        except ConnectionRefusedError:
            os.unlink(path)
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(path)
    os.chmod(path, 0o600)
    srv.listen(8)
    srv.setblocking(False)

    def on_conn(*_):
        try:
            conn, _addr = srv.accept()
        except BlockingIOError:
            return True
        with conn:
            conn.settimeout(0.5)
            try:
                data = conn.recv(256).decode(errors="replace").strip()
            except OSError:
                data = ""
        for cmd in data.split():
            switcher.command(cmd)
        return True

    # Must not be PRIORITY_HIGH: showing the layer surface from a high-priority
    # callback deadlocks GTK's Wayland event handling.
    GLib.io_add_watch(srv.fileno(), GLib.PRIORITY_DEFAULT, GLib.IO_IN, on_conn)
    return srv


def load_config(path):
    cfg = configparser.ConfigParser()
    cfg.read_dict(DEFAULTS)
    if path and os.path.exists(path):
        cfg.read(path)
    return cfg


def main():
    default_cfg = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
                               APP_NAME, "config.ini")
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-c", "--config", default=default_cfg, help=f"config file (default: {default_cfg})")
    args = ap.parse_args()

    cfg = load_config(args.config)
    switcher = Switcher(cfg)
    path = socket_path()
    srv = serve(switcher, path)
    log("listening on", path)
    try:
        Gtk.main()
    except KeyboardInterrupt:
        pass
    finally:
        srv.close()
        try:
            os.unlink(path)
        except OSError:
            pass


if __name__ == "__main__":
    main()
